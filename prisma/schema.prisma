// TruePath AI starts with a deliberately small domain model.
// Assessment scoring, AI inferences, and school analytics should be added only
// after the ethics and product contracts are validated.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  GUARDIAN
  EDUCATOR
  SCHOOL_ADMIN
}

enum ExplorationStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      UserRole @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  schoolProfile  SchoolProfile?
}

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  ageRange  String?
  interests Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  explorationSessions ExplorationSession[]
}

model SchoolProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  region    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExplorationSession {
  id               String            @id @default(cuid())
  studentProfileId String
  title            String
  status           ExplorationStatus @default(NOT_STARTED)
  reflections      Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId, status])
}
